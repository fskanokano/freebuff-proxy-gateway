# freebuff-proxy-gateway 环境变量示例
# 复制为真实值后通过 wrangler secret put 设置 (不要在仓库里提交真实 key)

# 下游 proxy base URL, 至少 1 个。单个: https://proxy-a.workers.dev
# 多个用英文逗号分隔 (每个 proxy 只配 1 个 FreeBuff token)
PROXIES=https://proxy-a.workers.dev

# 网关调用下游的 key (必填, 至少 1 个):
#   配 1 个 → 所有下游共用; 配 N 个 → 按顺序一一对应 N 个下游
# 这些 key 必须分别被对应 proxy 的 API_KEYS 接受
GATEWAY_API_KEYS=gw-secret-1

# 网关自身鉴权 key: 客户端调用网关时用 Authorization: Bearer <API_KEY>
# 可逗号分隔配多个 (每个客户端一个)
API_KEY=client-secret-1

# 管理后台专用鉴权 key (可选): 访问 /admin 用; 未配置则复用 API_KEY
# ADMIN_KEY=admin-secret-1

# ── 可选 ─────────────────────────────────────────────────────
# PIN_MODE=client             # client | header | off
# PIN_TTL_SECONDS=3600
# STATE_TTL_SECONDS=60
# DEPLETED_PROBE_SECONDS=300
# DOWN_PROBE_SECONDS=120
# PROBE_TIMEOUT_MS=3000
# MAX_ATTEMPTS=3
# LOG_LEVEL=info
