{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "freebuff-proxy-gateway",
  "main": "worker.js",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "PIN_MODE": "client",
    "PIN_TTL_SECONDS": "3600",
    "STATE_TTL_SECONDS": "60",
    "DEPLETED_PROBE_SECONDS": "300",
    "DOWN_PROBE_SECONDS": "120",
    "PROBE_TIMEOUT_MS": "3000",
    "MAX_ATTEMPTS": "3",
    "LOG_LEVEL": "info"
  },
  "kv_namespaces": []
}
